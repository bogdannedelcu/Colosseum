<launch> 

<!-- Colosseum ROS Wrapper -->
	<include file="$(find colosseum_ros_pkgs)/launch/colosseum_node.launch"/>
<!-- Vehicle Dynamic Constraints -->
	<include file="$(find colosseum_ros_pkgs)/launch/dynamic_constraints.launch"/>
<!-- Simple PID Position Controller -->
	<include file="$(find colosseum_ros_pkgs)/launch/position_controller_simple.launch"/>
</launch>
